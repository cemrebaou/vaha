---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localePaths, useI18n } from '@/i18n';
import type { Locale } from '@/i18n/config';

export const getStaticPaths = localePaths;

const locale = Astro.params.locale as Locale;
const { t } = useI18n(locale);
const l = t.login;
---

<BaseLayout locale={locale} title={l.title} noindex>
  <div class="container auth">
    <div class="auth__card">
      <header class="auth__head">
        <h1 class="h-2">{l.title}</h1>
        <p class="muted">{l.lead}</p>
      </header>

      <form class="auth__form">
        <div class="field">
          <label class="field__label" for="login-identifier">{l.identifier}</label>
          <input
            class="input auth__input"
            type="text"
            id="login-identifier"
            name="identifier"
            autocomplete="username"
            placeholder={l.identifierPlaceholder}
          />
        </div>
        <button class="btn btn--brand btn--lg btn--block" type="button">{l.continue}</button>
      </form>

      <p class="auth__or"><span>{l.or}</span></p>

      <div class="auth__alt">
        <button class="btn btn--outline btn--lg btn--block" type="button">{l.google}</button>
        <button class="btn btn--outline btn--lg btn--block" type="button">{l.apple}</button>
        <button class="btn btn--outline btn--lg btn--block" type="button">{l.uaepass}</button>
      </div>

      <p class="small muted">{l.note}</p>
    </div>
  </div>
</BaseLayout>

<style>
  .auth {
    display: grid;
    justify-items: center;
    padding-block: var(--s-7);
  }

  .auth__card {
    display: grid;
    gap: var(--s-5);
    width: 100%;
    max-width: 26rem;
  }

  .auth__head {
    display: grid;
    gap: var(--s-2);
  }

  .auth__form,
  .auth__alt {
    display: grid;
    gap: var(--s-3);
  }

  .auth__input {
    min-height: 3.25rem;
    font-size: var(--fs-body);
  }

  .auth__or {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--c-ink-3);
    font-size: var(--fs-sm);
  }

  .auth__or::before,
  .auth__or::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--c-line);
  }
</style>
