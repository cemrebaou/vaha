---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import PhotoPlaceholder from '@/components/listing/PhotoPlaceholder.astro';
import Tile from '@/components/listing/Tile.astro';
import { useI18n } from '@/i18n';
import { localeCodes, type Locale } from '@/i18n/config';
import { route } from '@/config/routes';
import { getGroup, getSub } from '@/config/categories';
import { city, getArea } from '@/config/areas';
import { setFields } from '@/config/filters';
import { fieldText } from '@/lib/fields';
import { getListing, getListings } from '@/lib/listings';

export function getStaticPaths() {
  return localeCodes.flatMap((locale) => getListings().map((item) => ({ params: { locale, id: item.id } })));
}

const locale = Astro.params.locale as Locale;
const item = getListing(Astro.params.id as string)!;
const { t, L, link, fmt } = useI18n(locale);
const l = t.listing;

const group = getGroup(item.group);
const sub = getSub(item.group, item.sub);
const title = L(item.title);
const area = L(getArea(item.area).name);

const period = { year: l.perYear, month: l.perMonth, day: l.perDay, hour: l.perHour };

// Bilgi tablosu: önce ilan no, tarih ve kategori, sonra kategoriye özel kriterler.
const rows = [
  { label: l.id, value: item.id, strong: true },
  { label: l.date, value: fmt.date(item.daysAgo) },
  { label: l.category, value: L(sub.name) },
  ...setFields(sub.set)
    .map((field) => ({ label: L(field.label), value: fieldText(field, item, locale, fmt.number) }))
    .filter((row): row is { label: string; value: string } => row.value !== null),
];

const tones = [1, 2, 3, 4] as const;
const thumbs = Array.from({ length: 6 }, (_, index) => tones[(item.tone + index) % 4]!);
const related = getListings({ group: item.group, sub: item.sub })
  .filter((other) => other.id !== item.id)
  .slice(0, 6);
---

<BaseLayout locale={locale} title={title}>
  <div class="container detail">
    <nav class="crumbs" aria-label={t.nav.categories}>
      <ol>
        <li><a href={link(route.home())}>{t.nav.home}</a></li>
        <li><a href={link(route.group(group.id))}>{L(group.name)}</a></li>
        <li><a href={link(route.sub(group.id, sub.id))}>{L(sub.name)}</a></li>
      </ol>
    </nav>

    <div class="detail__titlebar">
      <h1 class="detail__title">{title}</h1>
      <div class="detail__tools">
        <button class="btn btn--outline" type="button" data-fav={item.id} aria-pressed="false">
          <Icon name="heart" size={17} />
          {l.save}
        </button>
        <button class="btn btn--outline" type="button">
          <Icon name="share-2" size={17} />
          {l.share}
        </button>
      </div>
    </div>

    <div class="detail__grid">
      <div class="gallery">
        <PhotoPlaceholder tone={item.tone} icon={group.icon} label={l.photoSlot} ratio="4 / 3" />
        <ul class="gallery__thumbs">
          {
            thumbs.map((tone) => (
              <li>
                <PhotoPlaceholder tone={tone} icon="camera" label={l.photoSlot} ratio="4 / 3" small />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="info">
        <p class="info__price">
          {fmt.price(item.price)}
          {item.period && <span>{period[item.period]}</span>}
        </p>
        <p class="info__place">
          <Icon name="map-pin" size={16} />
          {L(city)}
          <span aria-hidden="true">/</span>
          {area}
        </p>
        {item.urgent && <p class="info__urgent">{l.urgent}</p>}
        <dl class="info__table">
          {
            rows.map((row) => (
              <div>
                <dt>{row.label}</dt>
                <dd class:list={{ strong: 'strong' in row && row.strong }}>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <aside class="seller">
        <div class="seller__id">
          <span class="seller__avatar">
            <Icon name="circle-user" size={28} />
          </span>
          <div>
            <p class="seller__name">{l.seller.name}</p>
            <p class="small muted">{l.seller.since}</p>
          </div>
        </div>
        <button class="btn btn--brand btn--lg btn--block" type="button">
          <Icon name="phone" size={18} />
          {l.seller.showPhone}
        </button>
        <button class="btn btn--outline btn--block" type="button">
          <Icon name="message-circle" size={18} />
          {l.seller.whatsapp}
        </button>
        <button class="btn btn--outline btn--block" type="button">{l.seller.message}</button>

        <div class="safety">
          <p class="safety__title">
            <Icon name="shield-check" size={18} />
            {l.safetyTitle}
          </p>
          <ul>
            {l.safety.map((tip) => <li>{tip}</li>)}
          </ul>
          <button class="safety__report" type="button">
            <Icon name="flag" size={15} />
            {l.report}
          </button>
        </div>
      </aside>
    </div>

    <section class="block">
      <h2 class="block__title">{l.description}</h2>
      <p class="prose">{l.descriptionText}</p>
    </section>

    <section class="block">
      <h2 class="block__title">{l.location}</h2>
      <div class="map">
        <Icon name="map" size={28} />
        <p>{L(city)}, {area}</p>
        <p class="small">{l.mapSoon}</p>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="block">
          <h2 class="block__title">{L(sub.name)}</h2>
          <ul class="related">
            {related.map((other) => (
              <li>
                <Tile locale={locale} item={other} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .detail {
    display: grid;
    gap: var(--s-4);
    padding-block-start: var(--s-4);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-2);
    color: var(--c-ink-3);
    font-size: var(--fs-xs);
  }

  .crumbs li + li::before {
    content: '/';
    margin-inline-end: var(--s-2);
    color: var(--c-line-strong);
  }

  .crumbs a {
    color: var(--c-brand);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  .detail__titlebar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding-block-end: var(--s-3);
    border-block-end: 1px solid var(--c-line);
  }

  .detail__title {
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 500;
    line-height: 1.3;
  }

  .detail__tools {
    display: flex;
    gap: var(--s-2);
  }

  .detail__tools :global(.btn) {
    min-height: 2.375rem;
    font-size: var(--fs-xs);
  }

  .detail__tools [aria-pressed='true'] {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  .detail__tools [aria-pressed='true'] :global(.icon) {
    fill: currentColor;
  }

  .detail__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) 17rem;
    align-items: start;
    gap: var(--s-5);
  }

  .gallery {
    display: grid;
    gap: var(--s-2);
  }

  .gallery > :global(.ph) {
    border-radius: var(--r-md);
  }

  .gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--s-2);
  }

  .gallery__thumbs :global(.ph) {
    border-radius: var(--r-xs);
  }

  .gallery__thumbs li:first-child :global(.ph) {
    outline: 2px solid var(--c-brand);
    outline-offset: 1px;
  }

  .info {
    display: grid;
    gap: var(--s-2);
    min-width: 0;
  }

  .info__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--c-brand);
    font-size: 1.5rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .info__price span {
    color: var(--c-ink-3);
    font-size: var(--fs-sm);
    font-weight: 400;
  }

  .info__place {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1);
    color: var(--c-brand);
    font-size: var(--fs-sm);
  }

  .info__urgent {
    justify-self: start;
    padding: 0.1rem 0.5rem;
    border-radius: var(--r-xs);
    background: var(--c-accent);
    color: var(--c-on-accent);
    font-size: var(--fs-2xs);
    font-weight: 600;
  }

  .info__table {
    margin-block-start: var(--s-2);
    border-block-start: 1px solid var(--c-line);
    font-size: var(--fs-xs);
  }

  .info__table div {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    padding-block: 0.5rem;
    border-block-end: 1px solid var(--c-line);
  }

  .info__table dt {
    color: var(--c-ink);
    font-weight: 600;
  }

  .info__table dd {
    color: var(--c-ink-2);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .info__table dd.strong {
    color: var(--c-accent);
    font-weight: 600;
  }

  .seller {
    position: sticky;
    top: calc(var(--header-h) + var(--s-4));
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    background: var(--c-raised);
  }

  .seller__id {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-block-end: var(--s-2);
  }

  .seller__avatar {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--c-brand-soft);
    color: var(--c-brand);
  }

  .seller__name {
    font-weight: 600;
  }

  .safety {
    display: grid;
    gap: var(--s-2);
    margin-block-start: var(--s-3);
    padding-block-start: var(--s-3);
    border-block-start: 1px solid var(--c-line);
    font-size: var(--fs-xs);
  }

  .safety__title {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 600;
  }

  .safety ul {
    display: grid;
    gap: var(--s-1);
    padding-inline-start: 1.1rem;
    color: var(--c-ink-2);
    list-style: disc;
  }

  .safety__report {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    color: var(--c-ink-2);
    font-size: var(--fs-xs);
  }

  .safety__report:hover {
    color: var(--c-accent);
  }

  .block {
    display: grid;
    gap: var(--s-3);
    margin-block-start: var(--s-3);
  }

  .block__title {
    padding-block-end: var(--s-2);
    border-block-end: 2px solid var(--c-brand);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0;
  }

  .prose {
    max-width: 70ch;
    color: var(--c-ink-2);
  }

  .map {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--s-1);
    min-height: 13rem;
    border: 1px dashed var(--c-line-strong);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    color: var(--c-ink-2);
  }

  .related {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--s-3);
  }

  @media (max-width: 1080px) {
    .detail__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .seller {
      position: static;
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    .detail__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .related {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
