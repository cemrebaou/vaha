---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResultsPage from '@/components/search/ResultsPage.astro';
import { useI18n } from '@/i18n';
import { localeCodes, type Locale } from '@/i18n/config';
import { groups, getGroup, getSub } from '@/config/categories';
import { getListings } from '@/lib/listings';

// Her dil ve her alt kategori için hazır bir sayfa üretilir.
export function getStaticPaths() {
  return localeCodes.flatMap((locale) =>
    groups.flatMap((group) => group.subs.map((sub) => ({ params: { locale, group: group.id, sub: sub.id } }))),
  );
}

const locale = Astro.params.locale as Locale;
const group = getGroup(Astro.params.group as string);
const sub = getSub(group.id, Astro.params.sub as string);
const { L } = useI18n(locale);
const name = L(sub.name);
---

<BaseLayout locale={locale} title={`${name} | ${L(group.name)}`}>
  <ResultsPage
    locale={locale}
    items={getListings({ group: group.id, sub: sub.id })}
    heading={name}
    group={group.id}
    sub={sub.id}
  />
</BaseLayout>
