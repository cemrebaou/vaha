---
interface Props {
  name: string;
  href: string;
}

const { name, href } = Astro.props;
---

<a class="logo" href={href} aria-label={name}>
  <svg class="logo__mark" width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
    <rect class="logo__a" x="7" y="7" width="18" height="18" rx="1.5" fill="none" stroke-width="2.2"></rect>
    <rect
      class="logo__b"
      x="7"
      y="7"
      width="18"
      height="18"
      rx="1.5"
      fill="none"
      stroke-width="2.2"
      transform="rotate(45 16 16)"></rect>
    <circle class="logo__pearl" cx="16" cy="16" r="3.25"></circle>
  </svg>
  <span class="logo__word">{name}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--s-2);
    color: var(--c-ink);
    text-decoration: none;
  }

  .logo__mark {
    flex: none;
  }

  .logo__a {
    stroke: var(--flag-green);
  }

  .logo__b {
    stroke: var(--flag-black);
  }

  .logo__pearl {
    fill: var(--flag-red);
  }

  .logo__word {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
</style>
