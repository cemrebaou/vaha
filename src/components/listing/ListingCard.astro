---
import Icon from '@/components/ui/Icon.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import { useI18n } from '@/i18n';
import type { Locale } from '@/i18n/config';
import { route } from '@/config/routes';
import { getCategory } from '@/config/categories';
import { areaName } from '@/config/areas';
import { listingFacts } from '@/lib/listingFacts';
import type { Listing } from '@/lib/listings';

interface Props {
  locale: Locale;
  item: Listing;
}

const { locale, item } = Astro.props;
const { t, link, fmt } = useI18n(locale);

const facts = listingFacts(item, t, fmt);
const deal = item.deal === 'sale' ? t.search.sale : item.deal === 'rent' ? t.search.rent : null;
---

<article class="card">
  <div class="card__media">
    <PhotoPlaceholder tone={item.tone} icon={getCategory(item.category).icon} label={t.listing.photoSlot} />
    <div class="card__badges">
      {deal && <span class="badge">{deal}</span>}
      {
        item.verified && (
          <span class="badge badge--verified">
            <Icon name="badge-check" size={14} />
            {t.listing.verified}
          </span>
        )
      }
    </div>
    <button class="card__fav" type="button" data-fav={item.id} aria-pressed="false" aria-label={t.listing.save}>
      <Icon name="heart" size={18} />
    </button>
  </div>

  <div class="card__body">
    <p class="card__price">
      {fmt.price(item.price)}
      {item.period === 'year' && <span class="card__period">/ {t.listing.perYear}</span>}
    </p>
    <h3 class="card__title">
      <a href={link(route.listing(item.id))}>{item.title[locale]}</a>
    </h3>
    {
      facts.length > 0 && (
        <ul class="card__facts">
          {facts.map((fact) => (
            <li>
              <Icon name={fact.icon} size={15} />
              {fact.text}
            </li>
          ))}
        </ul>
      )
    }
    <p class="card__place">
      <Icon name="map-pin" size={15} />
      {areaName(item.area, locale)}
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    background: var(--c-raised);
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .card:hover {
    border-color: var(--c-line-strong);
    box-shadow: var(--shadow-2);
    transform: translateY(-2px);
  }

  .card__media {
    position: relative;
  }

  .card__badges {
    position: absolute;
    inset-block-start: var(--s-3);
    inset-inline-start: var(--s-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    max-width: calc(100% - 4.5rem);
  }

  .card__fav {
    position: absolute;
    inset-block-start: var(--s-2);
    inset-inline-end: var(--s-2);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: var(--c-raised);
    color: var(--c-ink);
    box-shadow: var(--shadow-1);
    transition: transform 0.15s var(--ease);
  }

  .card__fav:hover {
    transform: scale(1.08);
  }

  .card__fav[aria-pressed='true'] {
    color: var(--c-danger);
  }

  .card__fav[aria-pressed='true'] :global(.icon) {
    fill: currentColor;
  }

  .card__body {
    display: grid;
    align-content: start;
    gap: var(--s-1);
    padding: var(--s-4);
  }

  .card__price {
    font-size: 1.1875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .card__period {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    font-weight: 400;
  }

  .card__title {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  /* Kartın tamamı tıklanabilir; favori düğmesi üstte kalır. */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    margin-block-start: var(--s-2);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }

  .card__facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .card__place {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    margin-block-start: var(--s-2);
    color: var(--c-ink-3);
    font-size: var(--fs-xs);
  }
</style>
