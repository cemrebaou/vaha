---
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import { useI18n } from '@/i18n';
import { locales, type Locale } from '@/i18n/config';
import { route } from '@/config/routes';
import { groups } from '@/config/categories';
import { currencies, defaultCurrency } from '@/config/currencies';

interface Props {
  locale: Locale;
  /** Aynı sayfanın diğer dillerdeki adresleri. */
  alternates: { locale: Locale; href: string }[];
}

const { locale, alternates } = Astro.props;
const { t, L, meta, link } = useI18n(locale);
---

<header class="site-header">
  <div class="flag-strip" aria-hidden="true"></div>
  <div class="container bar">
    <Logo name={t.site.name} href={link(route.home())} />

    <form class="hsearch" action={link(route.search())} method="get" role="search" aria-label={t.nav.searchLabel}>
      <input
        class="hsearch__input"
        type="search"
        id="header-q"
        name="q"
        placeholder={t.nav.searchPlaceholder}
        aria-label={t.nav.searchLabel}
        autocomplete="off"
        enterkeyhint="search"
      />
      <button class="hsearch__btn" type="submit" aria-label={t.nav.search}>
        <Icon name="search" size={19} />
      </button>
    </form>

    <a class="hlink only-desktop" href={link(route.advanced())}>{t.nav.advanced}</a>

    <div class="actions">
      <button class="hlink prefs-btn" type="button" popovertarget="prefs" aria-label={t.nav.prefs}>
        <Icon name="globe" size={17} />
        <span>{meta.short}</span>
      </button>
      <a class="hlink only-desktop" href={link(route.login())}>{t.nav.login}</a>
      <span class="sep only-desktop" aria-hidden="true"></span>
      <a class="hlink only-desktop" href={link(route.login())}>{t.nav.register}</a>
      <a class="btn btn--accent only-desktop post-btn" href={link(route.post())}>{t.nav.post}</a>
      <button class="icon-btn only-mobile" type="button" popovertarget="mobile-menu" aria-label={t.nav.menu}>
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<!-- Dil ve para birimi: düğmeye basınca açılır, sayfada yer kaplamaz. -->
<div class="prefs" id="prefs" popover>
  <p class="prefs__title">{t.nav.language}</p>
  <ul class="prefs__list">
    {
      alternates.map((item) => (
        <li>
          <a
            class="prefs__item"
            href={item.href}
            hreflang={locales[item.locale].hreflang}
            lang={item.locale}
            data-set-locale={item.locale}
            aria-current={item.locale === locale ? 'true' : undefined}
          >
            {locales[item.locale].label}
            {item.locale === locale && <Icon name="check" size={18} />}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="prefs__title">{t.nav.currency}</p>
  <ul class="prefs__list">
    {
      currencies.map((code) => (
        <li class:list={['prefs__item', { 'prefs__item--off': code !== defaultCurrency }]}>
          <span>
            {code} <span class="prefs__sub">{t.currencies[code]}</span>
          </span>
          {code === defaultCurrency && <Icon name="check" size={18} />}
        </li>
      ))
    }
  </ul>
  <p class="prefs__note">{t.nav.currencySoon}</p>
</div>

<!-- Mobil menü: tam ekran açılır. -->
<div class="mmenu" id="mobile-menu" popover>
  <div class="container mmenu__bar">
    <Logo name={t.site.name} href={link(route.home())} />
    <button
      class="icon-btn"
      type="button"
      popovertarget="mobile-menu"
      popovertargetaction="hide"
      aria-label={t.nav.close}
    >
      <Icon name="x" size={24} />
    </button>
  </div>
  <nav class="container mmenu__nav" aria-label={t.nav.main}>
    <ul>
      {
        groups.map((group) => (
          <li>
            <a href={link(route.group(group.id))}>
              <Icon name={group.icon} size={20} />
              <span>{L(group.name)}</span>
              <Icon name="chevron-right" size={18} flip />
            </a>
          </li>
        ))
      }
      <li>
        <a href={link(route.advanced())}>
          <Icon name="sliders-horizontal" size={20} />
          <span>{t.nav.advanced}</span>
          <Icon name="chevron-right" size={18} flip />
        </a>
      </li>
    </ul>
    <div class="mmenu__cta">
      <a class="btn btn--accent btn--lg btn--block" href={link(route.post())}>{t.nav.post}</a>
      <div class="mmenu__row">
        <a class="btn btn--outline btn--lg btn--block" href={link(route.login())}>{t.nav.login}</a>
        <a class="btn btn--outline btn--lg btn--block" href={link(route.login())}>{t.nav.register}</a>
      </div>
    </div>
  </nav>
</div>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 50;
    border-block-end: 1px solid var(--c-line);
    background: var(--c-bg);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    height: var(--header-h);
  }

  .hsearch {
    display: flex;
    flex: 1;
    max-width: 30rem;
    min-width: 0;
    height: 2.5rem;
    border: 1.5px solid var(--c-line-strong);
    border-radius: var(--r-sm);
    background: var(--c-bg);
    transition: border-color 0.15s var(--ease);
  }

  .hsearch:focus-within {
    border-color: var(--c-brand);
  }

  .hsearch__input {
    flex: 1;
    min-width: 0;
    padding-inline: var(--s-3);
    border: 0;
    outline: 0;
    background: transparent;
    font-size: var(--fs-sm);
  }

  .hsearch__input::placeholder {
    color: var(--c-ink-3);
  }

  .hsearch__btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    border: 0;
    border-inline-start: 1px solid var(--c-line);
    background: transparent;
    color: var(--c-ink-2);
  }

  .hsearch__btn:hover {
    color: var(--c-brand);
  }

  .hlink {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    padding: 0.375rem 0.25rem;
    border: 0;
    background: none;
    color: var(--c-ink);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .hlink:hover {
    color: var(--c-brand);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-inline-start: auto;
  }

  .prefs-btn {
    color: var(--c-ink-2);
  }

  .sep {
    width: 1px;
    height: 1rem;
    background: var(--c-line-strong);
  }

  .post-btn {
    min-height: 2.5rem;
    margin-inline-start: var(--s-2);
  }

  .only-mobile {
    display: none;
  }

  /* ---- Dil ve para birimi penceresi ---- */
  .prefs {
    position: fixed;
    inset: auto;
    inset-block-start: calc(var(--header-h) + 4px + env(safe-area-inset-top, 0px) + var(--s-2));
    inset-inline-end: max(var(--gutter), calc((100vw - var(--container)) / 2));
    width: min(19rem, calc(100vw - 2rem));
    margin: 0;
    padding: var(--s-4);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    background: var(--c-raised);
    color: var(--c-ink);
    box-shadow: var(--shadow-2);
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.16s var(--ease),
      transform 0.16s var(--ease),
      overlay 0.16s allow-discrete,
      display 0.16s allow-discrete;
  }

  .prefs:popover-open {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .prefs:popover-open {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  .prefs__title {
    margin-block-end: var(--s-1);
    color: var(--c-ink-3);
    font-size: var(--fs-xs);
    font-weight: 500;
  }

  .prefs__list {
    margin-block-end: var(--s-4);
  }

  .prefs__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: 2.5rem;
    padding-inline: var(--s-3);
    margin-inline: calc(var(--s-3) * -1);
    border-radius: var(--r-sm);
    color: var(--c-ink);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
  }

  a.prefs__item:hover {
    background: var(--c-surface);
  }

  .prefs__item[aria-current='true'] {
    color: var(--c-brand);
  }

  .prefs__item--off {
    color: var(--c-ink-3);
    font-weight: 400;
  }

  .prefs__sub {
    margin-inline-start: var(--s-1);
    color: var(--c-ink-3);
    font-weight: 400;
  }

  .prefs__note {
    color: var(--c-ink-3);
    font-size: var(--fs-xs);
  }

  /* ---- Mobil menü ---- */
  .mmenu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: env(safe-area-inset-top, 0px) 0 env(safe-area-inset-bottom, 0px);
    border: 0;
    background: var(--c-bg);
    color: var(--c-ink);
    overflow-y: auto;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.18s var(--ease),
      transform 0.18s var(--ease),
      overlay 0.18s allow-discrete,
      display 0.18s allow-discrete;
  }

  .mmenu:popover-open {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .mmenu:popover-open {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .mmenu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    border-block-end: 1px solid var(--c-line);
  }

  .mmenu__nav {
    padding-block: var(--s-2) var(--s-6);
  }

  .mmenu__nav li a {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 3.25rem;
    border-block-end: 1px solid var(--c-line);
    color: var(--c-ink);
    font-weight: 500;
    text-decoration: none;
  }

  .mmenu__nav li a :global(.icon:first-child) {
    color: var(--c-brand);
  }

  .mmenu__nav li a span {
    flex: 1;
  }

  .mmenu__cta {
    display: grid;
    gap: var(--s-3);
    margin-block-start: var(--s-5);
  }

  .mmenu__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-3);
  }

  @media (max-width: 960px) {
    .only-desktop {
      display: none;
    }

    .only-mobile {
      display: inline-grid;
    }

    .bar {
      flex-wrap: wrap;
      height: auto;
      row-gap: var(--s-2);
      padding-block: var(--s-2) var(--s-3);
    }

    .hsearch {
      order: 3;
      flex-basis: 100%;
      max-width: none;
    }

    .actions {
      gap: var(--s-1);
    }

    .prefs {
      inset-block-start: calc(var(--header-h) + var(--s-2));
      inset-inline-end: 1rem;
    }
  }
</style>
