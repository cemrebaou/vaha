---
import Icon from '@/components/ui/Icon.astro';
import { useI18n } from '@/i18n';
import type { Locale } from '@/i18n/config';
import { getCategory, categoryText, type CategoryId } from '@/config/categories';
import { areas, areaName } from '@/config/areas';
import { defaultCurrency } from '@/config/currencies';

interface Props {
  locale: Locale;
  /** Seçili kategori; yoksa tüm ilanlar için genel filtreler gösterilir. */
  category?: CategoryId;
  /** Formun gönderileceği adres (bulunulan sonuç sayfası). */
  action: string;
}

const { locale, category, action } = Astro.props;
const { t } = useI18n(locale);
const s = t.search;

const config = category ? getCategory(category) : undefined;
const text = category ? categoryText(t, category) : undefined;
const showDeal = !config || ('hasDeal' in config && config.hasDeal);
const showRooms = category === 'property';
const rooms = [
  { value: '0', label: t.listing.studio },
  { value: '1', label: '1' },
  { value: '2', label: '2' },
  { value: '3', label: '3' },
  { value: '4', label: '4+' },
];
---

<!-- Telefonda "Filtreler" düğmesiyle tam ekran açılır; geniş ekranda yanda sabit durur. -->
<aside class="filters" id="filters" aria-label={t.results.filters}>
  <div class="filters__head">
    <h2 class="h-3">{t.results.filters}</h2>
    <a class="icon-btn filters__close" href="#results" aria-label={t.nav.close}>
      <Icon name="x" size={22} />
    </a>
  </div>

  <form method="get" action={action}>
    {
      config && text && (
        <details class="fgroup" open>
          <summary>
            {text.name}
            <Icon name="chevron-down" size={18} />
          </summary>
          <div class="fgroup__body fgroup__body--list">
            {config.subs.map((sub) => (
              <label class="check" for={`f-sub-${sub}`}>
                <input type="checkbox" id={`f-sub-${sub}`} name="sub" value={sub} />
                {text.subs[sub]}
              </label>
            ))}
          </div>
        </details>
      )
    }

    {
      showDeal && (
        <details class="fgroup" open>
          <summary>
            {s.dealType}
            <Icon name="chevron-down" size={18} />
          </summary>
          <div class="fgroup__body">
            <div class="segmented">
              <label>
                <input type="radio" id="f-deal-any" name="deal" value="" checked />
                <span>{s.any}</span>
              </label>
              <label>
                <input type="radio" id="f-deal-sale" name="deal" value="sale" />
                <span>{s.sale}</span>
              </label>
              <label>
                <input type="radio" id="f-deal-rent" name="deal" value="rent" />
                <span>{s.rent}</span>
              </label>
            </div>
          </div>
        </details>
      )
    }

    <details class="fgroup" open>
      <summary>
        {s.price} ({defaultCurrency})
        <Icon name="chevron-down" size={18} />
      </summary>
      <div class="fgroup__body fgroup__body--range">
        <input
          class="input"
          type="number"
          id="f-min"
          name="min"
          min="0"
          inputmode="numeric"
          placeholder={s.priceMin}
          aria-label={s.priceMin}
        />
        <input
          class="input"
          type="number"
          id="f-max"
          name="max"
          min="0"
          inputmode="numeric"
          placeholder={s.priceMax}
          aria-label={s.priceMax}
        />
      </div>
    </details>

    {
      showRooms && (
        <details class="fgroup">
          <summary>
            {s.rooms}
            <Icon name="chevron-down" size={18} />
          </summary>
          <div class="fgroup__body fgroup__body--chips">
            {rooms.map((room) => (
              <label class="chip-check">
                <input type="checkbox" id={`f-rooms-${room.value}`} name="rooms" value={room.value} />
                <span class="chip">{room.label}</span>
              </label>
            ))}
          </div>
        </details>
      )
    }

    <details class="fgroup">
      <summary>
        {s.area}
        <Icon name="chevron-down" size={18} />
      </summary>
      <div class="fgroup__body fgroup__body--list">
        {
          areas.map((area) => (
            <label class="check" for={`f-area-${area.id}`}>
              <input type="checkbox" id={`f-area-${area.id}`} name="area" value={area.id} />
              {areaName(area.id, locale)}
            </label>
          ))
        }
      </div>
    </details>

    <label class="check filters__photos" for="f-photos">
      <input type="checkbox" id="f-photos" name="photos" value="1" />
      {s.withPhotos}
    </label>

    <div class="filters__actions">
      <button class="btn btn--brand btn--block" type="submit">{t.results.apply}</button>
      <a class="btn btn--ghost btn--block" href={action}>{t.results.clear}</a>
    </div>
  </form>
</aside>

<style>
  .filters {
    position: sticky;
    top: calc(var(--header-h) + var(--s-4));
    align-self: start;
    max-height: calc(100dvh - var(--header-h) - var(--s-6));
    overflow-y: auto;
    padding: var(--s-2) var(--s-5) var(--s-5);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    background: var(--c-raised);
  }

  .filters__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
  }

  .filters__close {
    display: none;
  }

  .fgroup {
    border-block-end: 1px solid var(--c-line);
  }

  .fgroup summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: 3rem;
    font-size: var(--fs-sm);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .fgroup summary::-webkit-details-marker {
    display: none;
  }

  .fgroup summary :global(.icon) {
    color: var(--c-ink-3);
    transition: transform 0.2s var(--ease);
  }

  .fgroup[open] summary :global(.icon) {
    transform: rotate(180deg);
  }

  .fgroup__body {
    padding-block-end: var(--s-4);
  }

  .fgroup__body--list {
    display: grid;
  }

  .fgroup__body--range {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-2);
  }

  .fgroup__body--chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .filters__photos {
    margin-block: var(--s-3);
  }

  .filters__actions {
    display: grid;
    gap: var(--s-2);
    margin-block-start: var(--s-2);
  }

  @media (max-width: 960px) {
    .filters {
      display: none;
    }

    .filters:target {
      position: fixed;
      inset: 0;
      z-index: 60;
      display: block;
      max-height: none;
      padding: env(safe-area-inset-top, 0px) max(var(--gutter), env(safe-area-inset-right, 0px))
        calc(var(--s-6) + env(safe-area-inset-bottom, 0px))
        max(var(--gutter), env(safe-area-inset-left, 0px));
      border: 0;
      border-radius: 0;
      background: var(--c-bg);
    }

    .filters__head {
      min-height: var(--header-h);
    }

    .filters__close {
      display: inline-grid;
    }
  }
</style>
