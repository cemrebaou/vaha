---
import { useI18n } from '@/i18n';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t, fmt } = useI18n(locale);
---

<section class="section">
  <div class="container">
    <div class="section__head">
      <h2 class="h-2">{t.home.howTitle}</h2>
    </div>
    <ol class="steps">
      {
        t.home.steps.map((step, index) => (
          <li class="step">
            <span class="step__no" aria-hidden="true">
              {fmt.number(index + 1)}
            </span>
            <h3 class="h-3">{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
  }

  .step {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding-block-start: var(--s-4);
    border-block-start: 2px solid var(--c-brand);
  }

  .step__no {
    color: var(--c-brand);
    font-size: 2rem;
    font-weight: 300;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .step p {
    max-width: 38ch;
    color: var(--c-ink-2);
  }

  @media (max-width: 760px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }
  }
</style>
