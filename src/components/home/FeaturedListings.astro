---
import Icon from '@/components/ui/Icon.astro';
import ListingGrid from '@/components/listing/ListingGrid.astro';
import { useI18n } from '@/i18n';
import type { Locale } from '@/i18n/config';
import { route } from '@/config/routes';
import { getFeaturedListings } from '@/lib/listings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t, link } = useI18n(locale);
const items = getFeaturedListings(8);
---

<section class="section section--tight">
  <div class="container">
    <div class="section__head">
      <div>
        <h2 class="h-2">{t.home.featuredTitle}</h2>
        <p class="muted small">{t.home.featuredNote}</p>
      </div>
      <a class="text-link" href={link(route.search())}>
        {t.home.seeAll}
        <Icon name="chevron-right" size={16} flip />
      </a>
    </div>
    <ListingGrid locale={locale} items={items} />
  </div>
</section>
