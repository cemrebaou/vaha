---
import Icon from '@/components/ui/Icon.astro';
import { useI18n } from '@/i18n';
import type { Locale } from '@/i18n/config';
import { route } from '@/config/routes';
import { categories, categoryText } from '@/config/categories';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t, link } = useI18n(locale);
---

<section class="section section--tight">
  <div class="container">
    <div class="section__head">
      <h2 class="h-2">{t.home.categoriesTitle}</h2>
      <a class="text-link" href={link(route.categories())}>
        {t.nav.allCategories}
        <Icon name="chevron-right" size={16} flip />
      </a>
    </div>
    <ul class="cats">
      {
        categories.map((item) => {
          const text = categoryText(t, item.id);
          return (
            <li>
              <a class="cat" href={link(route.category(item.id))}>
                <span class="cat__icon">
                  <Icon name={item.icon} size={24} />
                </span>
                <span class="cat__name">{text.name}</span>
                <span class="cat__hint">{text.hint}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .cats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .cat {
    display: grid;
    align-content: start;
    gap: 2px;
    height: 100%;
    padding: var(--s-4);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    color: var(--c-ink);
    text-decoration: none;
    transition: background-color 0.15s var(--ease);
  }

  .cat:hover {
    background: var(--c-surface-2);
  }

  .cat__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-block-end: var(--s-3);
    border-radius: var(--r-md);
    background: var(--c-raised);
    color: var(--c-brand);
  }

  .cat__name {
    font-weight: 500;
    line-height: 1.35;
  }

  .cat__hint {
    color: var(--c-ink-2);
    font-size: var(--fs-xs);
    line-height: 1.45;
  }

  @media (max-width: 860px) {
    .cats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
