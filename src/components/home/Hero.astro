---
import SearchPanel from '@/components/search/SearchPanel.astro';
import { useI18n } from '@/i18n';
import type { Locale } from '@/i18n/config';
import { route } from '@/config/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t, link } = useI18n(locale);
---

<section class="hero">
  <div class="hero__lattice" aria-hidden="true"></div>
  <div class="container hero__inner">
    <h1 class="h-display hero__title">{t.hero.title}</h1>
    <p class="lead">{t.hero.lead}</p>
    <SearchPanel locale={locale} />
    <div class="hero__popular">
      <span class="hero__popular-label">{t.hero.popular}</span>
      <ul>
        {
          t.hero.chips.map((chip) => (
            <li>
              <a class="chip" href={link(route.category(chip.category))}>{chip.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(180deg, var(--c-surface) 0%, var(--c-bg) 100%);
  }

  /* Sitenin tek gösterişli öğesi: köşeden süzülen meşrebiye kafesi. */
  .hero__lattice {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    z-index: -1;
    width: min(64%, 54rem);
  }

  @supports (mask-composite: intersect) {
    .hero__lattice {
      background: var(--c-brand);
      opacity: 0.14;
      mask-image: var(--lattice), radial-gradient(120% 105% at 100% 0%, #000 0%, transparent 68%);
      mask-size:
        56px 56px,
        100% 100%;
      mask-repeat: repeat, no-repeat;
      mask-composite: intersect;
    }

    :global([dir='rtl']) .hero__lattice {
      mask-image: var(--lattice), radial-gradient(120% 105% at 0% 0%, #000 0%, transparent 68%);
    }
  }

  .hero__inner {
    display: grid;
    gap: var(--s-5);
    padding-block: clamp(3rem, 8vw, 6.5rem) var(--s-7);
  }

  .hero__title {
    max-width: 17ch;
  }

  .hero__popular {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
  }

  .hero__popular-label {
    color: var(--c-ink-3);
    font-size: var(--fs-sm);
  }

  .hero__popular ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  @media (max-width: 760px) {
    .hero__lattice {
      width: 100%;
    }
  }
</style>
