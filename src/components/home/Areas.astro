---
import Icon from '@/components/ui/Icon.astro';
import { useI18n } from '@/i18n';
import type { Locale } from '@/i18n/config';
import { route } from '@/config/routes';
import { areas, areaName } from '@/config/areas';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t, link } = useI18n(locale);
---

<section class="section section--surface">
  <div class="container">
    <div class="section__head">
      <div>
        <h2 class="h-2">{t.home.areasTitle}</h2>
        <p class="muted">{t.home.areasLead}</p>
      </div>
    </div>
    <ul class="areas">
      {
        areas.map((area) => (
          <li>
            <a href={link(route.search())}>
              <span>{areaName(area.id, locale)}</span>
              <Icon name="chevron-right" size={18} flip />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .areas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    column-gap: var(--s-6);
  }

  .areas a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: 3.5rem;
    border-block-end: 1px solid var(--c-line-strong);
    color: var(--c-ink);
    font-size: 1.0625rem;
    text-decoration: none;
    transition: color 0.15s var(--ease);
  }

  .areas a:hover {
    color: var(--c-brand);
  }

  .areas span {
    min-width: 0;
  }
</style>
