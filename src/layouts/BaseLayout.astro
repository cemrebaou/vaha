---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import MobileTabBar from '@/components/layout/MobileTabBar.astro';
import { useI18n } from '@/i18n';
import { defaultLocale, localeCodes, locales, type Locale } from '@/i18n/config';
import { asset, href, stripLocale } from '@/lib/url';

interface Props {
  locale: Locale;
  /** Sekme başlığı. Boş bırakılırsa sitenin genel başlığı kullanılır. */
  title?: string;
  description?: string;
  /** Arama motorlarında görünmemesi gereken sayfalar (giriş, favoriler vb.). */
  noindex?: boolean;
  /** Dil değiştirince gidilecek yol. Varsayılan: bulunulan sayfanın karşılığı. */
  path?: string;
}

const { locale, title, description, noindex = false, path } = Astro.props;
const { t, meta } = useI18n(locale);

const rest = path ?? stripLocale(Astro.url.pathname, locale);
const alternates = localeCodes.map((code) => ({ locale: code, href: href(code, rest) }));

const pageTitle = title ? `${title} | ${t.site.name}` : t.site.title;
const pageDescription = description ?? t.site.description;
const absolute = (value: string) => new URL(value, Astro.site).href;
const canonical = absolute(href(locale, rest));
---

<!doctype html>
<html lang={locale} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map((item) => (
        <link rel="alternate" hreflang={locales[item.locale].hreflang} href={absolute(item.href)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absolute(href(defaultLocale, rest))} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.intl.slice(0, 5).replace('-', '_')} />
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <Header locale={locale} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} alternates={alternates} />
    <MobileTabBar locale={locale} />
    <script>
      import '@/scripts/prefs';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    inset-block-start: -5rem;
    inset-inline-start: var(--s-4);
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: var(--r-md);
    background: var(--c-ink);
    color: var(--c-bg);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .skip:focus {
    inset-block-start: var(--s-4);
  }
</style>
